# Copy to .env — it is read by Next.js, Prisma and Docker/Podman Compose.

# --- Database -----------------------------------------------------------------
# docker-compose.yml publishes PostgreSQL on localhost:5433.
POSTGRES_DB=canhoes
POSTGRES_USER=canhoes
POSTGRES_PASSWORD=canhoes_local
DATABASE_URL=postgresql://canhoes:canhoes_local@localhost:5433/canhoes?schema=public

# --- NextAuth -----------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google login. Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Development login: one-click admin session. Always off when NODE_ENV=production
# (so it never works inside the Docker image).
DEV_AUTH_BYPASS_ENABLED=true
DEV_AUTH_EMAIL=dev@example.com
DEV_AUTH_NAME="Dev User"

# Comma-separated emails the seed creates as admins (defaults to DEV_AUTH_EMAIL).
ADMIN_EMAILS=
# Fake members, categories and posts. Default: on with `npm run db:seed`, off in the container.
# SEED_DEMO_DATA=true

# --- Optional -----------------------------------------------------------------
# Behind a proxy or tunnel (ngrok), build auth URLs from the forwarded host.
# AUTH_TRUST_HOST=true
# Where uploaded images are stored (default: .data/uploads).
# UPLOADS_DIR=
# Public URL used in metadata (default: NEXTAUTH_URL).
# NEXT_PUBLIC_SITE_URL=
# Show the TanStack Query devtools in development.
# NEXT_PUBLIC_QUERY_DEVTOOLS=true
# Only for `compose --profile tunnel up` (public URL through ngrok).
# NGROK_AUTHTOKEN=
