{
  "name": "canhoes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --experimental-https -p 3000",
    "postinstall": "prisma generate",
    "build": "next build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,cjs}\"",
    "test": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "knip": "knip",
    "db:up": "node scripts/db.mjs up",
    "db:down": "node scripts/db.mjs down",
    "db:migrate": "prisma migrate deploy",
    "db:baseline": "node scripts/db.mjs baseline",
    "db:seed": "prisma db seed",
    "db:backup": "node scripts/db.mjs backup",
    "db:restore": "node scripts/db.mjs restore",
    "db:studio": "prisma studio"
  },
  "dependencies": {
