# Copy to .env.server on the server and fill it in. Never commit .env.server.
# Read by compose.server.yml and scripts/update-server.sh. Setup guide: docs/09-deploy.md.

# Database password. Generate with: openssl rand -hex 24
# Hex only, because it goes inside DATABASE_URL. It is fixed when the database is first created.
POSTGRES_PASSWORD=

# Public address of the site, with https and without a trailing slash.
NEXTAUTH_URL=https://canhoes.example.com
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google login. Redirect URI to register at Google: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become admins on every start.
ADMIN_EMAILS=

# Token of the Cloudflare Tunnel (Zero Trust > Networks > Tunnels > your tunnel).
CLOUDFLARE_TUNNEL_TOKEN=
