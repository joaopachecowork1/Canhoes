# Deploys the latest main of the checkout in ~/canhoes-server (scripts/update-server.sh).
# Installed as a user unit; see docs/09-deploy.md. Logs: journalctl --user -u canhoes-update
[Unit]
Description=Deploy the latest Canhões version
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/canhoes-server
# pip installs podman-compose in ~/.local/bin, which is not on the default PATH of user units.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/canhoes-server/scripts/update-server.sh
